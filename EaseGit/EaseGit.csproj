<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.1.0</Version>
        <!-- Команда в терминале — easegit: не путается с оригинальным lazygit. -->
        <AssemblyName>easegit</AssemblyName>
        <RootNamespace>EaseGit</RootNamespace>
    </PropertyGroup>

    <!-- dotnet publish -c Release -r linux-x64 → один исполняемый файл без установленного .NET. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <!-- Нативные библиотеки (libonigwrap для Terminal.Gui) — внутрь файла, а не рядом с ним. -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <!-- T("ru", "en") — строки интерфейса на текущем языке, см. Localization/Loc.cs -->
        <Using Include="EaseGit.Localization.Loc" Static="true" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="docs\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="docs\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="docs\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
      <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    </ItemGroup>

</Project>
