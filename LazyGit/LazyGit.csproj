<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- T("ru", "en") — строки интерфейса на текущем языке, см. Localization/Loc.cs -->
        <Using Include="LazyGit.Localization.Loc" Static="true" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="docs\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="docs\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="docs\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
      <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    </ItemGroup>

</Project>
